{
  "name": "@repo/db",
  "version": "0.0.1",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "build": "tsc",
    "dev": "tsx watch src/config.ts"
  },
  "exports": {
    "./client": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./types": {
      "types": "./src/generated/types.ts",
      "default": "./dist/generated/types.js"
    },
    "./enums": {
      "types": "./src/generated/enums.ts",
      "default": "./dist/generated/enums.js"
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.9",
    "prisma": "^5.19.1",
    "@servly/typescript-config": "workspace:*",
    "tsx": "^4.19.1"
  },
  "dependencies": {
    "kysely": "^0.27.4",
    "pg": "^8.12.0",
    "prisma-kysely": "^1.8.0"
  }
}
