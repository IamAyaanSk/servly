{
  "name": "@repo/db",
  "version": "0.0.1",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "rm -rf dist && tsc",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "dev": "tsc --watch --preserveWatchOutput --pretty"
  },
  "exports": {
    "./client": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./types": {
      "types": "./generated/types.ts",
      "default": "./dist/generated/types.js"
    },
    "./enums": {
      "types": "./src/generated/enums.ts",
      "default": "./dist/generated/enums.js"
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.9",
    "prisma": "^5.19.1",
    "@servly/typescript-config": "workspace:*",
    "@servly/eslint-config": "workspace:*"
  },
  "dependencies": {
    "kysely": "^0.27.4",
    "pg": "^8.12.0",
    "prisma-kysely": "^1.8.0"
  }
}
